#include <windows.h>
#include <commctrl.h>
#include "gui_resource.h"

IDD_AMS_MAIN_GUI DIALOGEX 0, 0, 430, 280
STYLE DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX | WS_MAXIMIZEBOX | WS_THICKFRAME
EXSTYLE WS_EX_APPWINDOW
CAPTION "计费管理系统 - GUI"
FONT 9, "Microsoft YaHei UI"
BEGIN
    CONTROL "", IDC_AMS_NAV_FRAME, "Static", SS_GRAYFRAME | WS_CHILD | WS_VISIBLE, 6, 6, 120, 268

    PUSHBUTTON "添加卡", IDC_AMS_NAV_ADD_CARD, 16, 18, 100, 24
    PUSHBUTTON "查询卡", IDC_AMS_NAV_QUERY_CARD, 16, 50, 100, 24
    PUSHBUTTON "上机", IDC_AMS_NAV_LOGON, 16, 82, 100, 24
    PUSHBUTTON "下机", IDC_AMS_NAV_SETTLE, 16, 114, 100, 24
    PUSHBUTTON "充值", IDC_AMS_NAV_RECHARGE, 16, 146, 100, 24
    PUSHBUTTON "退费", IDC_AMS_NAV_REFUND, 16, 178, 100, 24
    PUSHBUTTON "注销卡", IDC_AMS_NAV_CANCEL_CARD, 16, 210, 100, 24
    PUSHBUTTON "消费记录", IDC_AMS_NAV_BILLING, 16, 242, 100, 24
//  PUSHBUTTON "营业额统计", IDC_AMS_NAV_STAT, 16, 274, 100, 24
//  PUSHBUTTON "退出", IDC_AMS_NAV_EXIT, 16, 306, 100, 24

    LTEXT "字段1", IDC_AMS_LABEL_1, 140, 20, 130, 16
    EDITTEXT IDC_AMS_CARD_NAME, 140, 38, 130, 24, ES_AUTOHSCROLL
    LTEXT "字段2", IDC_AMS_LABEL_2, 290, 20, 130, 16
    EDITTEXT IDC_AMS_CARD_PASSWORD, 290, 38, 130, 24, ES_PASSWORD | ES_AUTOHSCROLL
    LTEXT "字段3", IDC_AMS_LABEL_3, 440, 20, 130, 16
    EDITTEXT IDC_AMS_CARD_MONEY, 440, 38, 130, 24, ES_AUTOHSCROLL

    PUSHBUTTON "执行", IDC_AMS_SUBMIT, 140, 72, 80, 26
    LTEXT "就绪", IDC_AMS_STATUS_TEXT, 230, 78, 340, 20

    CONTROL "", IDC_AMS_RESULT_LIST, "SysListView32", WS_TABSTOP | WS_CHILD | WS_VISIBLE | LVS_REPORT | LVS_SINGLESEL | WS_BORDER, 140, 110, 430, 150
END
