#include <windows.h>
#include <windows.h>
#include <commctrl.h>
#include "gui_resource.h"

IDD_AMS_MAIN_GUI DIALOGEX 0, 0, 600, 420
STYLE DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX | WS_MAXIMIZEBOX | WS_THICKFRAME
EXSTYLE WS_EX_APPWINDOW
CAPTION "计费管理系统 - GUI"
FONT 9, "Microsoft YaHei UI"
BEGIN
    CONTROL "", IDC_STATIC, "Static", SS_GRAYFRAME | WS_CHILD | WS_VISIBLE, 6, 6, 180, 628

    PUSHBUTTON "添加卡", IDC_AMS_NAV_ADD_CARD, 18, 24, 156, 28
    PUSHBUTTON "查询卡", IDC_AMS_NAV_QUERY_CARD, 18, 58, 156, 28
    PUSHBUTTON "上机", IDC_AMS_NAV_LOGON, 18, 92, 156, 28
    PUSHBUTTON "下机", IDC_AMS_NAV_SETTLE, 18, 126, 156, 28
    PUSHBUTTON "充值", IDC_AMS_NAV_RECHARGE, 18, 160, 156, 28
    PUSHBUTTON "退费", IDC_AMS_NAV_REFUND, 18, 194, 156, 28
    PUSHBUTTON "注销卡", IDC_AMS_NAV_CANCEL_CARD, 18, 228, 156, 28
    PUSHBUTTON "消费记录", IDC_AMS_NAV_BILLING, 18, 262, 156, 28
    PUSHBUTTON "营业额统计", IDC_AMS_NAV_STAT, 18, 296, 156, 28
    PUSHBUTTON "退出", IDC_AMS_NAV_EXIT, 18, 330, 156, 28

    LTEXT "字段1", IDC_AMS_LABEL_1, 206, 20, 100, 16
    EDITTEXT IDC_AMS_CARD_NAME, 206, 38, 240, 24, ES_AUTOHSCROLL
    LTEXT "字段2", IDC_AMS_LABEL_2, 470, 20, 100, 16
    EDITTEXT IDC_AMS_CARD_PASSWORD, 470, 38, 240, 24, ES_PASSWORD | ES_AUTOHSCROLL
    LTEXT "字段3", IDC_AMS_LABEL_3, 734, 20, 100, 16
    EDITTEXT IDC_AMS_CARD_MONEY, 734, 38, 210, 24, ES_AUTOHSCROLL

    PUSHBUTTON "执行", IDC_AMS_SUBMIT, 206, 72, 90, 26
    LTEXT "就绪", IDC_AMS_STATUS_TEXT, 314, 78, 630, 20

    CONTROL "", IDC_AMS_RESULT_LIST, "SysListView32", WS_TABSTOP | WS_CHILD | WS_VISIBLE | LVS_REPORT | LVS_SINGLESEL | WS_BORDER, 206, 110, 738, 524
END
